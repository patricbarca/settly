{
  "sourceLanguage": "en",
  "strings": {
    "Add expense": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir gasto"
          }
        }
      }
    },
    "Describe an expense, like “taxi 30 with Emma”. Settlia opens it ready for you to review before saving.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe un gasto, como “taxi 30 con Emma”. Settlia lo abre listo para que lo revises antes de guardarlo."
          }
        }
      }
    },
    "Expense": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto"
          }
        }
      }
    },
    "Merchant": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comercio"
          }
        }
      }
    },
    "Amount": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe"
          }
        }
      }
    },
    "Add ${note} to Settlia": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir ${note} a Settlia"
          }
        }
      }
    },
    "What did you spend?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué gastaste?"
          }
        }
      }
    },
    "Scan receipt": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear ticket"
          }
        }
      }
    },
    "Opens Settlia straight to the receipt scanner.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Settlia directamente en el escáner de tickets."
          }
        }
      }
    },
    "Scan a receipt from ${merchant}": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanear un ticket de ${merchant}"
          }
        }
      }
    },
    "Ask about a payment": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar por un pago"
          }
        }
      }
    },
    "For the Wallet automation: Settlia sends a notification to add the payment, without opening the app. Small payments and merchants you chose are skipped.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para la automatización de Wallet: Settlia te manda una notificación para añadir el pago, sin abrir la app. Se saltan los pagos pequeños y los comercios que elegiste."
          }
        }
      }
    },
    "Ask about a payment at ${merchant}": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar por un pago en ${merchant}"
          }
        }
      }
    },
    "Turn on Settlia notifications in Settings so it can ask about your payments.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las notificaciones de Settlia en Ajustes para que te pregunte por tus pagos."
          }
        }
      }
    }
  },
  "version": "1.0"
}